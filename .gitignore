/target

# VitePress
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Claude Code: share the project settings, keep worktrees and local settings out.
!.claude/
.claude/*
!.claude/settings.json

# Sandcastle: share the config; .sandcastle/.gitignore keeps .env, logs and worktrees out.
!.sandcastle/

# playwright-cli writes snapshots and console logs into the folder it runs from.
.playwright-cli/
# lefthook: machine-only hooks
lefthook-local.yml
